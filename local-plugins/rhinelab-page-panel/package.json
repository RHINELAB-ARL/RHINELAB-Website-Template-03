{
  "name": "rhinelab-page-panel",
  "version": "1.0.0",
  "description": "RHINELAB docs: Sphinx-style page panel (previous/next topic, this page, page stats, keys) for Quartz 5.",
  "type": "module",
  "license": "MIT",
  "author": "RHINELAB",
  "files": [
    "dist",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./types": {
      "types": "./dist/types.d.ts",
      "import": "./dist/types.js"
    },
    "./components": {
      "types": "./dist/components/index.d.ts",
      "import": "./dist/components/index.js"
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "preact": "^10.0.0"
  },
  "dependencies": {
    "@quartz-community/types": "^1.3.0",
    "@quartz-community/utils": "^1.1.1"
  },
  "devDependencies": {
    "@types/hast": "^3.0.4",
    "@types/mdast": "^4.0.4",
    "@types/node": "^24.10.0",
    "preact": "^10.28.2",
    "sass": "^1.97.3",
    "tsup": "^8.5.0",
    "typescript": "^5.9.3",
    "unified": "^11.0.5",
    "vfile": "^6.0.3"
  },
  "quartz": {
    "name": "rhinelab-page-panel",
    "displayName": "RHINELAB Page Panel",
    "category": "component",
    "version": "1.0.0",
    "quartzVersion": ">=5.0.0",
    "dependencies": [],
    "defaultOrder": 50,
    "defaultEnabled": true,
    "defaultOptions": {
      "exclude": [
        "tags/",
        "404"
      ],
      "wordsPerMinute": 220,
      "showFilterKey": true
    },
    "optionSchema": {
      "editBaseUrl": {
        "type": "string"
      },
      "issuesUrl": {
        "type": "string"
      },
      "exclude": {
        "type": "array"
      },
      "wordsPerMinute": {
        "type": "number"
      },
      "showFilterKey": {
        "type": "boolean"
      }
    },
    "components": {
      "RhinelabPagePanel": {
        "displayName": "RHINELAB Page Panel",
        "defaultPosition": "left",
        "defaultPriority": 60
      }
    }
  },
  "engines": {
    "node": ">=22"
  }
}